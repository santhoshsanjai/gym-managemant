# Used by docker-compose.yml. Copy to .env and fill in.
DOMAIN=gym.example.com
POSTGRES_USER=gym
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=gym

JWT_SECRET=replace-with-64-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-then-change-in-app

# Gym policy: see backend/.env.example for every option and its default.
GYM_TIMEZONE=Asia/Kolkata
ATTENDANCE_MAX_CHECKINS_PER_DAY=1
ATTENDANCE_REQUIRE_ACTIVE_SUBSCRIPTION=true
REMINDER_DAYS_BEFORE_EXPIRY=[7,1]
