# Copy to .env (local dev) or set in the environment. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://gym:gym@localhost:5432/gym
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:4200"]

# Optional: create this admin on first start if no admin exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- Gym policy (scope section 13). Defaults shown. ---
GYM_TIMEZONE=Asia/Kolkata
GYM_DAY_START_HOUR=0
ATTENDANCE_MAX_CHECKINS_PER_DAY=1
ATTENDANCE_REQUIRE_ACTIVE_SUBSCRIPTION=true
QR_TOKEN_TTL_SECONDS=60
QR_TOKEN_GRACE_SECONDS=15
REMINDER_DAYS_BEFORE_EXPIRY=[7,1]
REMINDER_RUN_HOUR=8
UPCOMING_EXPIRY_WINDOW_DAYS=7
MEMBER_EDITABLE_FIELDS=["email","address","gender","date_of_birth","photo_url"]

# Optional Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
